# Caddy получает и продлевает сертификат Let's Encrypt автоматически.
# DOMAIN — доменное имя (например, dating-myname.duckdns.org) или публичный IP-адрес.
{$DOMAIN} {
	tls {
		issuer acme {
			# Короткий профиль (сертификат на ~6 суток, Caddy продлевает сам).
			# Обязателен для сертификата на IP-адрес, для домена тоже работает.
			profile shortlived
			# Проверка через порт 80 (HTTP-01) — самый надежный вариант для IP-адреса
			disable_tlsalpn_challenge
		}
	}
	encode gzip
	request_body {
		max_size 6MB
	}
	reverse_proxy app:8080
}
