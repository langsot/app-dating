# Скопируйте в .env и заполните: cp .env.example .env

# Домен или публичный IP-адрес сервера (без https://)
DOMAIN=203.0.113.10

# Токен бота от @BotFather
BOT_TOKEN=123456789:AA...

# Секрет подписи токенов, не менее 32 символов: openssl rand -hex 32
JWT_SECRET=

# Пароль базы данных: openssl rand -hex 16
DB_PASSWORD=
