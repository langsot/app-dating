# Скопируйте в .env и заполните: cp .env.example .env

# Адрес приложения в Cloudflare (без https://), тот же, что в настройках туннеля
DOMAIN=dating.example.com

# Токен туннеля: Cloudflare Zero Trust -> Networks -> Tunnels -> ваш туннель
CLOUDFLARE_TUNNEL_TOKEN=

# Токен бота от @BotFather
BOT_TOKEN=123456789:AA...

# Секрет подписи токенов, не менее 32 символов: openssl rand -hex 32
JWT_SECRET=

# Пароль базы данных: openssl rand -hex 16
DB_PASSWORD=
